# Token de TON bot (Developer Portal > Bot > Reset Token). Ne le partage JAMAIS.
DISCORD_TOKEN=colle_ton_token_ici
# Application ID (Developer Portal > General Information > Application ID)
CLIENT_ID=colle_id_application_ici
# Ton ID Discord (clic droit sur ton profil > Copier l'identifiant, mode développeur activé)
OWNER_ID=ton_id_discord

# MongoDB (stockage persistant : configs, warns, cases). Sans ça, tout est
# perdu à chaque redémarrage de Render.
MONGODB_URI=

# Clé API Groq GRATUITE (https://console.groq.com/keys), pour le chat IA.
GROQ_API_KEY=
# Modèle utilisé pour le chat (gratuit, gros quota par défaut).
GROQ_MODEL=llama-3.1-8b-instant

# Clé API YouTube GRATUITE (optionnelle, pour que l'IA cherche des vidéos/musiques).
YOUTUBE_API_KEY=

# URL publique Render (https://ton-app.onrender.com), pour l'anti-veille.
PUBLIC_URL=
PORT=3000
